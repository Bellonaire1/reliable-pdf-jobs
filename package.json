{
  "name": "reliable-pdf-jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Database-backed background job foundation for PDF generation",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:api": "tsx scripts/verify-api.ts",
    "verify:retry-guards": "tsx scripts/verify-retry-guards.ts",
    "worker": "tsx src/worker.ts",
    "verify:worker": "tsx scripts/verify-worker.ts",
    "verify:retries": "tsx scripts/verify-retries.ts",
    "verify:recovery": "tsx scripts/verify-recovery.ts",
    "break-it": "tsx scripts/break-it.ts",
    "evidence:statuses": "tsx scripts/evidence-statuses.ts",
    "evidence:backoff": "tsx scripts/evidence-backoff.ts",
    "evidence:concurrency": "tsx scripts/evidence-concurrency.ts",
    "evidence:crash:prepare": "tsx scripts/evidence-crash.ts prepare",
    "evidence:crash:kill": "tsx scripts/evidence-crash.ts kill",
    "evidence:crash:recover": "tsx scripts/evidence-crash.ts recover",
    "evidence:capture:crash": "tsx scripts/evidence-capture.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pdfkit": "^0.17.2",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.0",
    "@types/pdfkit": "^0.13.9",
    "prisma": "^6.16.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
